{
  "schema": 1,
  "runsOn": "ubuntu-latest",
  "setup": [
    "npm ci"
  ],
  "build": [
    "npm run build"
  ],
  "probes": [
    {
      "kind": "browser",
      "url": "/collection"
    },
    {
      "kind": "browser",
      "url": "/configure"
    },
    {
      "kind": "browser",
      "url": "/strap/dial"
    },
    {
      "kind": "http",
      "url": "/api/waitlist"
    }
  ]
}